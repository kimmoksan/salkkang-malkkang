# 복사해서 backend/.env 로 쓰기. .env는 커밋하지 않는다.
# mock: 예시 모드(키 불필요) / live: 실제 Gemini 호출
APP_MODE=mock
# 실제 키는 .env에만. 프론트(VITE_*) 변수에 넣지 않는다.
GEMINI_API_KEY=
# 사용할 모델 ID는 공식 문서·계정에서 확인 후 기입
GEMINI_MODEL=
# 서버가 하루에 보낼 Gemini 요청 상한(무료 등급은 모델당 하루 20회). 넘으면 예시 모드로 대체
GEMINI_DAILY_LIMIT=15
# IP별 1분당 요청 상한(링크 읽기·공방 API)
RATE_LIMIT_PER_MIN=12
# 운영: frontend 빌드 결과를 같은 주소에서 제공. 개발 서버 사용 시 0.
SERVE_FRONTEND=0
HOST=127.0.0.1
PORT=8000
# 비어 있으면 전달 헤더 무시. 운영 프록시의 실제 접속 IP/CIDR만 지정(* 금지).
FORWARDED_ALLOW_IPS=
